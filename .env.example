# Root env file consumed by the docker-compose files — copy to .env and fill in.
# (compose reads ./.env automatically for ${VAR} interpolation)

# Required — Google Gemini API key for the model server
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required — JWT signing secret for the backend. Use a long random string.
JWT_SECRET=your_random_secure_jwt_secret

# Required — shared secret the backend sends to the model server as the
# X-Internal-Token header (the model server rejects requests without it).
INTERNAL_API_TOKEN=your_random_shared_internal_token

# Required — mongo root credentials. The image creates this user in the
# `admin` db on first boot of a fresh mongo-data volume; the backend
# authenticates with the same pair (MONGODB_URI in compose). Keep the
# password alphanumeric (or URL-encode it) — it is embedded in that URI.
MONGO_INITDB_ROOT_USERNAME=ragroot
MONGO_INITDB_ROOT_PASSWORD=your_random_secure_mongo_password

# Optional — comma-separated extra CORS origins (e.g. a deployed frontend
# that bypasses the bundled nginx's /api proxy and calls the backend
# cross-origin)
# CORS_ORIGIN=https://example.com

# Optional — production image coordinates used by docker-compose.yml.
# The EC2 bootstrap writes real values into the box's .env; the defaults
# below (shown commented) keep a dev checkout tagging local builds sanely.
# ECR_REGISTRY=localhost
# ECR_MODEL_SERVER_REPO=egyptian-tour-guide-rag-model-server
# ECR_BACKEND_REPO=egyptian-tour-guide-rag-backend
# ECR_FRONTEND_REPO=egyptian-tour-guide-rag-frontend
# IMAGE_TAG=latest
# APP_PORT=3000
