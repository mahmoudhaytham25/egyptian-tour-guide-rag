# Root env file consumed by docker-compose.yml — copy to .env and fill in.
# (compose reads ./.env automatically for ${VAR} interpolation)

# Required — Google Gemini API key for the model server
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required — JWT signing secret for the backend. Use a long random string.
JWT_SECRET=your_random_secure_jwt_secret

# Required — shared secret the backend sends to the model server as the
# X-Internal-Token header (the model server rejects requests without it).
INTERNAL_API_TOKEN=your_random_shared_internal_token

# Optional — comma-separated extra CORS origins (e.g. a deployed frontend)
# CORS_ORIGIN=https://example.com
