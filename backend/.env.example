# Port for the Express API server (frontend defaults to http://localhost:3001/api)
PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/egyptian_history_rag

# JWT signing secret — use a long random string in production (required)
JWT_SECRET=your_random_secure_jwt_secret

# Base URL of the Flask model server (required)
MODEL_SERVER_URL=http://localhost:5050

# Shared secret sent to the model server as the X-Internal-Token header
# (required — must match the model server's INTERNAL_API_TOKEN)
INTERNAL_API_TOKEN=your_random_shared_internal_token

# Optional: comma-separated list of extra allowed CORS origins
# (defaults to the local dev origins if unset)
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: rate-limit tuning (requests per window)
# AUTH_RATE_LIMIT_MAX=20   (per 15 min, on /api/auth/*)
# API_RATE_LIMIT_MAX=60    (per minute, on /api/query|upload|index)
# STATUS_RATE_LIMIT_MAX=120 (per minute, on /api/indexing-status|documents)
# RATE_LIMIT_DISABLED=true (bypass the limiter — tests only)

# Optional: shared PDF data directory with the model server
# (defaults to ../model-server/data; vector_store stays its sibling)
# MODEL_SERVER_DATA_DIR=/path/to/model-server/data
