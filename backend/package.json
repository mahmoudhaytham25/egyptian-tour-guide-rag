{
    "name": "egyptian-history-rag",
    "version": "1.0.0",
    "description": "RAG system for Egyptian history using Node.js and Python",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "migrate:create": "migrate-mongo create",
        "migrate:status": "migrate-mongo status"
    },
    "keywords": [
        "rag",
        "llm",
        "egyptian-history",
        "node",
        "python"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.11.1",
        "multer": "^2.0.2"
    },
    "devDependencies": {
        "jest": "^30.5.2",
        "nodemon": "^3.1.14",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    },
    "engines": {
        "node": ">=24"
    }
}
