# Google Gemini API key (required) — get one at https://aistudio.google.com/app/apikey
# Used for BOTH LLM generation and embeddings (indexing and querying), plus
# network access — there is no local model fallback.
# (Older docs may refer to this as GOOGLE_API_KEY; the code reads GEMINI_API_KEY.)
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the Flask model server (default: 5050)
PORT=5050

# Bind address (default: 127.0.0.1). docker-compose sets HOST=0.0.0.0 so the
# backend container can reach the server — keep 127.0.0.1 for local dev.
# HOST=0.0.0.0
