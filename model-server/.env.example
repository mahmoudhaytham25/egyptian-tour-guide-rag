# Google Gemini API key (required) — get one at https://aistudio.google.com/app/apikey
# Used for BOTH LLM generation and embeddings (indexing and querying), plus
# network access — there is no local model fallback.
# (Older docs may refer to this as GOOGLE_API_KEY; the code reads GEMINI_API_KEY.)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — comma-separated fallback models tried in order when the primary
# model (gemini-3.8-flash) returns a rate-limit error. Each model has its own
# quota counter, so this rides out both per-minute and daily quota exhaustion.
# Default chain walks down the flash tiers: 3.7, 3.6, 3.5, 3.5-lite,
# 3.1-lite, 3-flash-preview, 2.5, 2.5-lite.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Shared secret for internal auth (REQUIRED — the server refuses to start
# without it). The Express backend sends this value in the X-Internal-Token
# header on every request except /health. Must match the backend's
# INTERNAL_API_TOKEN — generate a long random string.
INTERNAL_API_TOKEN=change_me_to_a_long_random_string

# Port for the Flask model server (default: 5050)
PORT=5050

# Bind address (default: 127.0.0.1). docker-compose sets HOST=0.0.0.0 so the
# backend container can reach the server — keep 127.0.0.1 for local dev.
# HOST=0.0.0.0
