# nginx-unprivileged runs as a non-root user and listens on 8080.
#
# This is an envsubst TEMPLATE, not a live config: the image's
# /docker-entrypoint.sh renders it into /etc/nginx/conf.d/default.conf at
# container start, substituting only real container env vars — so nginx
# variables like $uri below are left alone (unless a deployer exports a
# same-named env var, which the nginx docs advise against here).
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # NOTE: an add_header inside a `location` replaces ALL inherited
    # server-level add_headers, so the security headers are repeated in
    # every location that sets its own headers.
    #
    # connect-src: the browser calls the backend API directly
    # (VITE_API_URL, default http://localhost:3001/api). ${API_CONNECT_SRC}
    # is the ORIGIN part of that URL — scheme://host[:port], no /api path —
    # rendered at container start (default in the Dockerfile). For a real
    # deploy, override at runtime, no rebuild needed:
    #   docker run -e API_CONNECT_SRC=https://api.example.com ...
    location /assets/ {
        # Vite emits content-hashed filenames under /assets — cache forever.
        expires 1y;
        add_header Cache-Control "immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    location / {
        # SPA fallback — client-side routes (/chat, /register) must resolve
        # to index.html so react-router can handle them. Always revalidate
        # the HTML so new deploys take effect immediately.
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}
